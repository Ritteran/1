# Gmail SMTP Configuration for Daily Newsletter
# Copy this file to .env and fill in your actual credentials

# Your Gmail address (sender)
GMAIL_ADDRESS=your.email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate this from: https://myaccount.google.com/apppasswords
# You'll need to enable 2-Step Verification first
GMAIL_APP_PASSWORD=your-16-digit-app-password

# Newsletter recipient email address
RECIPIENT_EMAIL=benjamin.prajwal57@gmail.com
